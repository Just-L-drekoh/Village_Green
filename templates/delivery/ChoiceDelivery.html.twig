{% extends 'base.html.twig' %}

{% block body %}
	<h1 class="text-3xl font-extrabold text-center text-gray-800 mb-6">Choisissez les quantités pour la livraison</h1>

	{{ form_start(form, {'attr': {'class': 'space-y-6 max-w-xl mx-auto p-4 border-2 border-blue-500 rounded-lg shadow-lg bg-white'}}) }}
	{{ form_widget(form, {'attr': {'class': 'w-full p-3 border-2 border-gray-300 rounded-lg focus:ring-4 focus:ring-blue-500 focus:outline-none text-lg text-gray-700'}}) }}

	<button type="submit" class="w-full bg-blue-600 text-white py-3 px-6 rounded-lg text-xl font-semibold hover:bg-blue-700 focus:ring-4 focus:ring-blue-500 focus:outline-none transition duration-300">
		Valider
	</button>
	{{ form_end(form) }}
{% endblock %}
