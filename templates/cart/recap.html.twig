{% extends 'base.html.twig' %}

{% block title %}Récapitulatif de commande
{% endblock %}

{% block body %}
	<div class="container mx-auto my-8">
		<h1 class="text-2xl font-bold mb-6">Récapitulatif de votre commande</h1>

		{% if cartDetails %}
			<div class="bg-white shadow-md rounded p-6">
				<table class="w-full mb-6">
					<thead>
						<tr class="border-b-2 border-gray-200">
							<th class="text-left py-2">Produit</th>
							<th class="text-right py-2">Prix unitaire</th>
							<th class="text-center py-2">Quantité</th>
							<th class="text-right py-2">Total HT</th>
							<th class="text-right py-2">TVA</th>
							<th class="text-right py-2">Coef</th>
							<th class="text-right py-2">Total TTC</th>
						</tr>
					</thead>
					<tbody>
						{% for item in cartDetails %}
							<tr class="border-b border-gray-100">
								<td class="py-4">
									<div class="font-semibold">{{ item.product.label }}</div>
									<div class="text-sm text-gray-600">Réf:
										{{ item.product.ref }}</div>
								</td>
								<td class="text-right py-4">{{ item.details.price_per_unit|number_format(2, ',', ' ') }}
									€</td>
								<td class="text-center py-4">{{ item.quantity }}</td>
								<td class="text-right py-4">{{ item.details.price_quantity|number_format(2, ',', ' ') }}
									€</td>
								<td class="text-right py-4">{{ (item.details.price_with_tax - item.details.price_quantity)|number_format(2, ',', ' ') }}
									€</td>
								<td class="text-right py-4">{{ (item.details.user_coef)|number_format(2, ',', ' ') }}
								</td>
								<td class="text-right py-4 font-semibold">{{ item.details.final_price|number_format(2, ',', ' ') }}
									€</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>

				{# Calcul des totaux #}
				{% set totalHT = 0 %}
				{% set totalTVA = 0 %}
				{% set totalTTC = 0 %}
				{% for item in cartDetails %}
					{% set totalHT = totalHT + item.details.price_quantity %}
					{% set totalTVA = totalTVA + (item.details.price_with_tax - item.details.price_quantity) %}
					{% set totalTTC = totalTTC + item.details.final_price %}
				{% endfor %}

				{# Affichage des totaux #}
				<div class="flex justify-end">
					<div class="w-1/3">
						<div class="border-t-2 border-gray-200 pt-4">
							<div class="flex justify-between mb-2">
								<span>Total HT :</span>
								<span>{{ totalHT|number_format(2, ',', ' ') }}
									€</span>
							</div>
							<div class="flex justify-between mb-2">
								<span>Total TVA :</span>
								<span>{{ totalTVA|number_format(2, ',', ' ') }}
									€</span>
							</div>
							<div class="flex justify-between font-bold text-lg">
								<span>Total TTC :</span>
								<span>{{ totalTTC|number_format(2, ',', ' ') }}
									€</span>
							</div>
						</div>
					</div>
				</div>
				<p class="mt-4 text-gray-700 text-sm italic">
					<span class="font-semibold">Le prix affiché</span>
					comprend le tarif de base du produit,
					<span class="font-medium text-gray-800">ajusté par le coefficient appliqué par l'administrateur du site "{{cartDetails[0].details.user_coef}}"</span>, 
						    ainsi que la
					<span class="underline">TVA applicable en France</span>.
				</p>

				<div class="mt-8 flex justify-end space-x-4">
					<a href="{{ path('cart_index') }}" class="bg-gray-500 text-white px-6 py-2 rounded hover:bg-gray-600">
						Retour au panier
					</a>
					<button class="bg-green-500 text-white px-6 py-2 rounded hover:bg-green-600">
						<a href="{{path('validation_cart_paiement')}}">
							Valider est payer
						</a>
					</button>
				</div>
			</div>
		{% else %}
			<div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4">
				<p>Votre panier est vide.</p>
			</div>
			<div class="mt-4">
				<a href="{{path('cart_index')}}" class="text-blue-500 hover:underline">
					Retourner à la boutique
				</a>
			</div>
		{% endif %}
	</div>
{% endblock %}
